# AI Provider: "anthropic" or "mock" (default: "mock")
VITE_AI_PROVIDER=mock

# Node server. Defaults bind only to the local machine.
HOST=127.0.0.1
PORT=3001

# Server-only Anthropic credentials. Never prefix secrets with VITE_.
ANTHROPIC_API_KEY=
# Required when ANTHROPIC_API_KEY is set. Use a model enabled for your account.
ANTHROPIC_MODEL=

# Optional comma-separated browser origins. Defaults include localhost and
# 127.0.0.1 on ports 3001 and 5173.
# ALLOWED_ORIGINS=http://127.0.0.1:5173

# Optional production asset directory (default: dist).
# STATIC_DIR=dist
